# ============================================================================
# ShopKart Backend Environment Configuration Template
# Duplicate this file to .env and configure for your environment
# ============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=shopkart
DB_PORT=3306

# JWT Authentication
JWT_SECRET=replace_with_a_strong_production_secret
JWT_EXPIRES_IN=7d